# =====================================
# XPCHunter — Git Ignore
# =====================================

# Build artifacts
build/obj/
build/bin/
build/*.sys
*.obj
*.pdb
*.map
*.exp
*.lib
*.ilk

# IDA Pro database files (regeneratable)
*.id0
*.id1
*.id2
*.nam
*.til

# VS / MSVC
.vs/
*.suo
*.user
*.sdf
*.opensdf
*.log
Debug/
Release/
x64/
Win32/
ipch/
*.VC.db
*.VC.opendb

# Windows
Thumbs.db
Desktop.ini

# Python cache
__pycache__/
*.pyc
*.pyo

# Temp files
*.tmp
*.bak
~$*

# IDE
.idea/
*.swp
*.swo
*~
# Build log output
build/*.log
build/*.txt

# 双机调试签名产物（含测试私钥，禁止提交）
build/sign/*.pfx
build/sign/*.pvk
build/sign/*.cer
build/sign/*.sys
build/sign/probe*/
build/sign/*.log
build/sign/*.ps1
build/sign/*.bat
build/sign/*.txt

# 诊断期源文件备份（不入库，避免与权威源码混淆）
*.probe_backup

# 双机调试期间的临时产物（截图/scratch，非结论性证据，不入库）
build/audit/*.png
build/audit/*.bmp
build/audit/_lm_*.txt
build/audit/_split_tmp.txt
build/audit/_gttest.bin
build/audit/_mklm.py
# ntoskrnl 已有入库副本 ntoskrnl_guest.exe（同 SHA1），不再重复
build/audit/ntoskrnl_19045.exe

# IDA MCP 运行时目录（临时会话/缓存）
.ida-mcp/

# ntoskrnl.exe 本体（微软二进制，9.9MB）不入库；只保留派生出的导出映射
build/audit/nt/*.exe

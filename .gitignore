# =====================================
# XPCHunter — Git Ignore
# =====================================

# Build artifacts
build/obj/
build/bin/
build/*.sys
*.obj
*.pdb
*.map
*.exp
*.lib
*.ilk

# IDA Pro database files (regeneratable)
*.id0
*.id1
*.id2
*.nam
*.til

# VS / MSVC
.vs/
*.suo
*.user
*.sdf
*.opensdf
*.log
Debug/
Release/
x64/
Win32/
ipch/
*.VC.db
*.VC.opendb

# Windows
Thumbs.db
Desktop.ini

# Python cache
__pycache__/
*.pyc
*.pyo

# Temp files
*.tmp
*.bak
~$*

# IDE
.idea/
*.swp
*.swo
*~
# Build log output
build/*.log
build/*.txt

# 双机调试签名产物（含测试私钥，禁止提交）
build/sign/*.pfx
build/sign/*.pvk
build/sign/*.cer
build/sign/*.sys
build/sign/probe*/
build/sign/*.log
build/sign/*.ps1
build/sign/*.bat
build/sign/*.txt
